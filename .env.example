# Copy to .env (Node). Kestrel reads it on boot.
# Docker/Dokploy/Render: set these in the service environment instead.

# The dashboard password. Use a long random value.
ADMIN_PASSWORD=change-me

# Signs the login cookie. Generate with: openssl rand -hex 32
# If omitted on Node, Kestrel generates one and stores it in DATA_DIR/session-secret.
SESSION_SECRET=

# Where the SQLite file and generated secret live.
DATA_DIR=data
# DATABASE_PATH=data/kestrel.db

# HTTP server.
HOST=0.0.0.0
PORT=3000
# Optional dev-only overrides: browser-facing Vite port and its proxied API port.
# VITE_PORT=3000
# API_PORT=3001

# Public URL of this instance (used in docs/snippets; optional).
SITE_URL=

# Tracked events allowed per minute per IP. 0 disables the limiter.
INGEST_RATE_LIMIT=300

# Public showcase mode: exposes the demo dashboard as read-only and rejects all API writes.
DEMO_MODE=false
